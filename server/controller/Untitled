const crypto = require("crypto");
const Team = require("../model/Team");
const TeamInvitation = require("../model/TeamInvitation");
const User = require("../model/User");
const { sendTeamInvitationEmail } = require("../services/email.service");

// ─── POST /api/teams ──────────────────────────────────────────────────────────
// Create a new team. The authenticated user becomes the owner.
const createTeam = async (req, res) => {
  try {
    const { name, description, inviteEmails = [] } = req.body;

    if (!name || !name.trim()) {
      return res.status(400).json({ success: false, message: "Team name is required." });
    }

    // Create the team with the owner as the first member
    const team = await Team.create({
      name: name.trim(),
      description: description?.trim() || "",
      owner: req.user._id,
      members: [{ user: req.user._id, role: "owner" }],
    });

    // Send invitations to provided emails (fire-and-forget errors per invite)
    const inviteResults = await Promise.allSettled(
      inviteEmails.map((email) => _createAndSendInvite({ email, team, inviter: req.user }))
    );

    const sentInvites = inviteResults
      .map((r, i) => ({
        email: inviteEmails[i],
        status: r.status === "fulfilled" ? r.value.status : "failed",
        reason: r.status === "rejected" ? r.reason?.message : undefined,
      }));

    const populated = await team.populate("members.user", "name email avatar");

    res.status(201).json({
      success: true,
      message: "Team created successfully.",
      team: populated,
      invitations: sentInvites,
    });
  } catch (error) {
    console.error("createTeam error:", error);
    res.status(500).json({ success: false, message: error.message });
  }
};

// ─── POST /api/teams/:teamId/invite ──────────────────────────────────────────
// Owner invites additional members by email after team creation.
const inviteMember = async (req, res) => {
  try {
    const { teamId } = req.params;
    const { email } = req.body;

    if (!email) {
      return res.status(400).json({ success: false, message: "Email is required." });
    }

    const team = await Team.findById(teamId);
    if (!team) {
      return res.status(404).json({ success: false, message: "Team not found." });
    }

    // Only the owner can invite
    if (team.owner.toString() !== req.user._id.toString()) {
      return res.status(403).json({ success: false, message: "Only the team owner can invite members." });
    }

    const result = await _createAndSendInvite({ email, team, inviter: req.user });

    res.status(200).json({
      success: true,
      message: result.message,
      invitation: result.invitation,
    });
  } catch (error) {
    console.error("inviteMember error:", error);
    res.status(500).json({ success: false, message: error.message });
  }
};

// ─── GET /api/teams/invite/accept/:token ─────────────────────────────────────
// Magic link handler — user clicks "Accept" in their email.
const acceptInvitation = async (req, res) => {
  try {
    const { token } = req.params;

    const invitation = await TeamInvitation.findOne({ token }).populate("team");
    if (!invitation) {
      return res.redirect(`${process.env.CLIENT_URL}/invite/invalid`);
    }

    if (invitation.status !== "pending") {
      return res.redirect(
        `${process.env.CLIENT_URL}/invite/already-${invitation.status}`
      );
    }

    if (invitation.expiresAt < new Date()) {
      invitation.status = "rejected";
      await invitation.save();
      return res.redirect(`${process.env.CLIENT_URL}/invite/expired`);
    }

    const team = await Team.findById(invitation.team._id);

    // Check if this email's user is already a member
    const invitedUser = await User.findOne({ email: invitation.invitedEmail });
    if (invitedUser) {
      const alreadyMember = team.members.some(
        (m) => m.user.toString() === invitedUser._id.toString()
      );
      if (!alreadyMember) {
        team.members.push({ user: invitedUser._id, role: "member" });
        await team.save();
      }
    }

    invitation.status = "accepted";
    await invitation.save();

    // Redirect to frontend — they may need to log in first
    return res.redirect(
      `${process.env.CLIENT_URL}/invite/accepted?team=${encodeURIComponent(team.name)}`
    );
  } catch (error) {
    console.error("acceptInvitation error:", error);
    return res.redirect(`${process.env.CLIENT_URL}/invite/error`);
  }
};

// ─── GET /api/teams/invite/reject/:token ─────────────────────────────────────
// Magic link handler — user clicks "Decline" in their email.
const rejectInvitation = async (req, res) => {
  try {
    const { token } = req.params;

    const invitation = await TeamInvitation.findOne({ token });
    if (!invitation) {
      return res.redirect(`${process.env.CLIENT_URL}/invite/invalid`);
    }

    if (invitation.status !== "pending") {
      return res.redirect(
        `${process.env.CLIENT_URL}/invite/already-${invitation.status}`
      );
    }

    invitation.status = "rejected";
    await invitation.save();

    return res.redirect(`${process.env.CLIENT_URL}/invite/rejected`);
  } catch (error) {
    console.error("rejectInvitation error:", error);
    return res.redirect(`${process.env.CLIENT_URL}/invite/error`);
  }
};

// ─── GET /api/teams ───────────────────────────────────────────────────────────
// Get all teams the authenticated user belongs to.
const getUserTeams = async (req, res) => {
  try {
    const teams = await Team.find({ "members.user": req.user._id })
      .populate("members.user", "name email avatar")
      .populate("owner", "name email avatar")
      .sort({ createdAt: -1 });

    res.json({ success: true, teams });
  } catch (error) {
    console.error("getUserTeams error:", error);
    res.status(500).json({ success: false, message: error.message });
  }
};

// ─── GET /api/teams/:teamId ───────────────────────────────────────────────────
// Get a single team (must be a member).
const getTeamById = async (req, res) => {
  try {
    const { teamId } = req.params;

    const team = await Team.findById(teamId)
      .populate("members.user", "name email avatar")
      .populate("owner", "name email avatar");

    if (!team) {
      return res.status(404).json({ success: false, message: "Team not found." });
    }

    const isMember = team.members.some(
      (m) => m.user._id.toString() === req.user._id.toString()
    );
    if (!isMember) {
      return res.status(403).json({ success: false, message: "Access denied." });
    }

    // Also return pending invitations for this team (owner only)
    let pendingInvitations = [];
    if (team.owner._id.toString() === req.user._id.toString()) {
      pendingInvitations = await TeamInvitation.find({
        team: teamId,
        status: "pending",
      }).select("invitedEmail createdAt expiresAt");
    }

    res.json({ success: true, team, pendingInvitations });
  } catch (error) {
    console.error("getTeamById error:", error);
    res.status(500).json({ success: false, message: error.message });
  }
};

// ─── Internal helper ──────────────────────────────────────────────────────────
async function _createAndSendInvite({ email, team, inviter }) {
  const normalizedEmail = email.toLowerCase().trim();

  // Check if already a member
  const existingUser = await User.findOne({ email: normalizedEmail });
  if (existingUser) {
    const alreadyMember = team.members.some(
      (m) => m.user.toString() === existingUser._id.toString()
    );
    if (alreadyMember) {
      return { status: "skipped", message: `${normalizedEmail} is already a team member.` };
    }
  }

  // Check for existing pending invite
  const existingInvite = await TeamInvitation.findOne({
    team: team._id,
    invitedEmail: normalizedEmail,
    status: "pending",
  });
  if (existingInvite) {
    return { status: "skipped", message: `Pending invitation already exists for ${normalizedEmail}.` };
  }

  // Generate a secure random token
  const token = crypto.randomBytes(32).toString("hex");

  const invitation = await TeamInvitation.create({
    team: team._id,
    invitedEmail: normalizedEmail,
    invitedBy: inviter._id,
    token,
  });

  const acceptUrl = `${process.env.API_URL}/api/teams/invite/accept/${token}`;
  const rejectUrl = `${process.env.API_URL}/api/teams/invite/reject/${token}`;

  await sendTeamInvitationEmail({
    toEmail: normalizedEmail,
    inviterName: inviter.name,
    teamName: team.name,
    acceptUrl,
    rejectUrl,
  });

  return { status: "sent", message: `Invitation sent to ${normalizedEmail}.`, invitation };
}

module.exports = {
  createTeam,
  inviteMember,
  acceptInvitation,
  rejectInvitation,
  getUserTeams,
  getTeamById,
};